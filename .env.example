# jira-view environment — copy to `.env` and fill in. `.env` is gitignored.
#
# dev.sh sources this file with bash: if a value contains $, ` or spaces,
# wrap it in double quotes.
#
# Create an API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token-here

# Your site root, without a trailing slash:
JIRA_BASE_URL=https://your-site.atlassian.net

# Optional
JIRA_VIEW_PORT=8787

# Optional: the native Jira "Flagged" field is discovered by name. Set these
# only if your site uses a different field/option naming.
# JIRA_FLAGGED_FIELD=customfield_10021
# JIRA_FLAGGED_VALUE=Impediment
